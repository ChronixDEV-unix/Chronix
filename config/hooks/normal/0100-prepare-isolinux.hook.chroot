#!/bin/sh
set -eu

# live-build runs this hook inside the target chroot after package installation.
# Populate the location expected by lb_binary_syslinux from matching BIOS files.
DEST="/root/isolinux"
BIOS_MODULES="/usr/lib/syslinux/modules/bios"
mkdir -p "$DEST"

if [ ! -s /usr/lib/ISOLINUX/isolinux.bin ]; then
  echo "ISOLINUX package did not provide /usr/lib/ISOLINUX/isolinux.bin" >&2
  exit 1
fi
cp -L /usr/lib/ISOLINUX/isolinux.bin "$DEST/isolinux.bin"

for file in vesamenu.c32 ldlinux.c32 libcom32.c32 libgpl.c32 libmenu.c32 libutil.c32; do
  if [ ! -s "$BIOS_MODULES/$file" ]; then
    echo "Missing BIOS SYSLINUX module: $BIOS_MODULES/$file" >&2
    exit 1
  fi
  cp -L "$BIOS_MODULES/$file" "$DEST/$file"
done

echo "Prepared ISOLINUX files inside the build chroot:"
ls -lh "$DEST"
